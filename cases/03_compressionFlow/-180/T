FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "-180";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    piston
    {
        type            zeroGradient;
    }

    cylinderHead
    {
        type            zeroGradient;
    }

    cylinderWall
    {
        type            zeroGradient;
    }

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}

