FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "-180";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    piston
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    cylinderHead
    {
        type            noSlip;
    }

    cylinderWall
    {
        type            noSlip;
    }

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}

